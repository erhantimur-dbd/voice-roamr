# Postgres (Neon or any Postgres). Required for accounts, agents, billing.
DATABASE_URL=

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://roamr-mobile.vercel.app

# Grok 2.0 Voice (demo, agents, TTS/STT)
XAI_API_KEY=

# Stripe Checkout + webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend transactional email (hello@ / support@ / billing@ roamr.mobile)
RESEND_API_KEY=

# Twilio local number search + purchase + inbound voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Optional: keep sign-in on in production builds
VITE_AUTH_ENABLED=true
